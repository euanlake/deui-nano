# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# macOS / iCloud duplicate copies (e.g. "sdkconfig 2", "espressif__freetype 2")
* 2
* 2/

# Editor / IDE (machine-local; keep extensions.json in repo if you add one)
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets and local env
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Logs and scratch
*.log
screenlog.*
*.tmp
*.bak

# --- ESP-IDF (firmware/esp32) ---
firmware/esp32/build/
firmware/esp32/managed_components/
firmware/esp32/.cache/
firmware/esp32/sdkconfig.old
firmware/esp32/sdkconfig.ci
firmware/esp32/dependencies.lock.bak

# sdkconfig + sdkconfig.defaults are committed; ignore personal menuconfig overrides
firmware/esp32/sdkconfig.user
firmware/esp32/sdkconfig.local

# --- Firmware release artifacts (CI → GitHub Releases) ---
firmware/release/

# --- GitHub Pages install bundles (CI → Pages; binaries are not stored in git) ---
install/firmware/*.bin

# --- Arduino / PlatformIO (legacy archived tree, if used) ---
.pio/
.pioenvs/
.piolibdeps/
archive/arduino-prototype/build/

# Build / flash binary artifacts
*.hex
*.elf
*.map
*.bin

# Python
__pycache__/
*.py[cod]
.Python
.venv/
venv/
.pytest_cache/

# Coverage / test output
coverage/
*.gcno
*.gcda
